# ==============================================================================
# BrandNest Environment Configuration Template
# Copy to .env for local overrides, or configure in Vercel Project Settings.
# NEVER commit real secrets, passwords, or API tokens to Git.
# ==============================================================================

# Environment mode: 'development' (local) or 'production' (Vercel/deployed)
DJANGO_ENV=development
DJANGO_DEBUG=True

# Required in production (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=replace-with-strong-random-secret-key

# Comma-separated hostnames (e.g., brandnest.com,www.brandnest.com,.vercel.app)
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app

# Comma-separated HTTPS origins allowed for CSRF form submissions
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://brandnest.com,https://www.brandnest.com

# Comma-separated origins allowed for cross-origin API requests in production
CORS_ALLOWED_ORIGINS=https://brandnest.com,https://www.brandnest.com

# Platform base domain for generated subdomains
PLATFORM_BASE_DOMAIN=sites.brandnest.local

# ==============================================================================
# Database (Neon PostgreSQL in Production; omitted locally to use SQLite)
# Prefer Neon's pooled connection string (-pooler host) for Vercel serverless.
# ==============================================================================
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_CONN_MAX_AGE=0
# DB_SSL_REQUIRE=True

# Optional individual PostgreSQL variables (used only if DATABASE_URL is not set)
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=your-neon-password
# DB_HOST=ep-example-pooler.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_SSLMODE=require

# ==============================================================================
# Media Storage (Cloudflare R2 S3-compatible object storage in Production)
# Leave unset locally to continue using local backend/media/ filesystem storage.
# ==============================================================================
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# AWS_STORAGE_BUCKET_NAME=brandnest-media
# AWS_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=media.brandnest.com

# ==============================================================================
# Optional Production Security Overrides (enabled automatically when DEBUG=False)
# ==============================================================================
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

